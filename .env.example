# 可选运行参数：复制为 .env 后按需修改；模型 API 地址、模型名和 Key 请配置在 models.json。
# .env 已被 .gitignore 忽略，不会提交。
# 如果 models.json 中使用 api_key_env，请在系统环境变量中设置对应的 Key。

# 模型生成参数（可选）
# ZHIPU_TEMPERATURE=0.2
# ZHIPU_MAX_TOKENS=
# ZHIPU_TIMEOUT=300
# ZHIPU_RETRIES=4
# ZHIPU_STREAM=1
# ZHIPU_JSON_MODE=0

# 流水线运行参数（可选）
# AGENT_CONCURRENCY=3
# AGENT_FIX_ROUNDS=3
# AGENT_DIRECT_CHARS=60000
# NODE_BIN=node
# SKILLS_DIR=

# 可选：将模型配置文件放在其他位置；默认读取项目根目录 models.json
# AGENT_MODELS_FILE=D:\\config\\models.json

# 视频 API 的地址、模型和 Key 池同样写在 models.json 的 video 列表中。
# 详见 docs/video-generation.md。
AGENT_STORYBOARD_PARAMS={"minCutSeconds":4,"maxCutSeconds":10,"maxOnScreen":6,"maxSegmentSeconds":30,"nameGate":false,"nameAllow":["九尾狐妖"]}
