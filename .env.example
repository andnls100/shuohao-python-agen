# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）
ZHIPU_API_KEY=
ZHIPU_MODEL=
# 默认智谱官方；聚合平台换成它给的 OpenAI 兼容地址即可
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# 可选：staging 阶段认场景设定图用的视觉模型；不填就按提示词推算站位
ZHIPU_VISION_MODEL=
# 以下都有默认值，可不填
# ZHIPU_TEMPERATURE=0.2
# ZHIPU_MAX_TOKENS=
# ZHIPU_TIMEOUT=300
# ZHIPU_RETRIES=4
# ZHIPU_STREAM=1   平台不支持流式时改成 0
# ZHIPU_JSON_MODE=0
# AGENT_CONCURRENCY=3
# AGENT_FIX_ROUNDS=3
# AGENT_DIRECT_CHARS=60000
# NODE_BIN=node
# SKILLS_DIR=
