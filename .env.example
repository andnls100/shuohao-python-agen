# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）
ZHIPU_API_KEY=
ZHIPU_MODEL=
# 默认智谱官方；聚合平台换成它给的 OpenAI 兼容地址即可
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# 可选：staging 阶段认场景设定图用的视觉模型；不填就按提示词推算站位
ZHIPU_VISION_MODEL=
# 视觉模型默认和文本模型用同一个平台；在另一个平台上时，单独指定地址和 Key
# ZHIPU_VISION_BASE_URL=
# ZHIPU_VISION_API_KEY=
# 需要多个文本模型 / 多个平台（号池）时，不用改这里：复制 models.example.json 为 models.json。
# 存在 models.json 时，上面的模型、地址、Key 都不再生效。
# 以下都有默认值，可不填
# ZHIPU_TEMPERATURE=0.2
# ZHIPU_MAX_TOKENS=
# ZHIPU_TIMEOUT=300
# ZHIPU_RETRIES=4
# ZHIPU_STREAM=1   平台不支持流式时改成 0
# ZHIPU_JSON_MODE=0
# AGENT_CONCURRENCY=3
# AGENT_FIX_ROUNDS=3
# AGENT_DIRECT_CHARS=60000
# NODE_BIN=node
# SKILLS_DIR=

# Optional cloud video generation. Preview is the default; --video-submit is required to call the API.
# The request/response shape varies by provider; see docs/video-generation.md.
# VIDEO_API_SUBMIT_URL=https://your-provider.example/v1/videos/generations
# VIDEO_API_STATUS_URL_TEMPLATE=https://your-provider.example/v1/videos/{task_id}
# VIDEO_API_KEY=
# VIDEO_API_MODEL=
# VIDEO_API_TIMEOUT=120
# VIDEO_API_POLL_INTERVAL=5
# VIDEO_API_MAX_WAIT=900
