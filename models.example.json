{
  "strategy": "failover",
  "cooldown": 120,
  "text": [
    {
      "name": "智谱-flash",
      "base_url": "https://open.bigmodel.cn/api/paas/v4/",
      "api_keys": ["Key1", "Key2"],
      "model": "glm-5.3-flash"
    },
    {
      "name": "聚合平台-备用",
      "base_url": "https://你的聚合平台地址/v1",
      "api_key_env": "AGGREGATOR_API_KEY",
      "model": "平台上的模型名",
      "max_tokens": 8192,
      "stream": true
    }
  ],
  "vision": [
    {
      "name": "智谱-视觉",
      "base_url": "https://open.bigmodel.cn/api/paas/v4/",
      "api_key": "把这里换成平台一的 Key",
      "model": "glm-5.3-flashx"
    }
  ],
  "image": [
    {
      "name": "图片平台主用",
      "base_url": "https://你的图片平台/v1",
      "api_key": "替换成图片平台 Key",
      "model": "平台支持的生图模型名",
      "endpoint": "/images/generations",
      "size": "1536x1024",
      "quality": "high",
      "timeout": 180
    },
    {
      "name": "图片平台备用",
      "base_url": "https://你的备用图片平台/v1",
      "api_key": "替换成备用图片平台 Key",
      "model": "备用平台支持的生图模型名",
      "endpoint": "/images/generations",
      "size": "1536x1024",
      "quality": "high",
      "timeout": 180
    }
  ],
  "image_style": {
    "look": "写实",
    "character_mode": "portrait",
    "negative": "omit"
  },
  "audio": [
    {
      "name": "百炼-CosyVoice",
      "provider": "cosyvoice_tts",
      "speech_url": "https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer",
      "voice_design_url": "https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/customization",
      "api_key_env": "DASHSCOPE_API_KEY",
      "model": "cosyvoice-v3.5-flash",
      "response_format": "mp3",
      "sample_rate": 24000,
      "voice_language_hints": ["zh"],
      "language_hints": ["zh"],
      "voice_preview_text": "你好，我是这个故事中的角色，很高兴认识你。",
      "timeout": 120
    }
  ],
  "video": [
    {
      "name": "视频平台主用",
      "submit_url": "https://你的主视频平台/v1/videos/generations",
      "status_url_template": "https://你的主视频平台/v1/videos/{task_id}",
      "api_key_env": "VIDEO_PRIMARY_API_KEY",
      "model": "视频模型名",
      "timeout": 120,
      "poll_interval": 5,
      "max_wait": 900
    },
    {
      "name": "视频平台备用",
      "submit_url": "https://你的备用视频平台/v1/videos/generations",
      "status_url_template": "https://你的备用视频平台/v1/videos/{task_id}",
      "api_key_env": "VIDEO_BACKUP_API_KEY",
      "model": "备用视频模型名",
      "timeout": 120,
      "poll_interval": 5,
      "max_wait": 900
    }
  ]
}
